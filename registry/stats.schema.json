{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mazillka/deckyhub-registry/main/registry/stats.schema.json",
  "title": "DeckyHub stats.json (published on the release-index branches)",
  "description": "One entry per plugin, keyed by lowercase owner/name. Fields and warning IDs are only ever added: DeckyHub, the browser extension and the site read them, and old copies never update.",
  "type": "object",
  "required": ["generatedAt", "plugins"],
  "properties": {
    "generatedAt": { "type": "string" },
    "plugins": {
      "type": "object",
      "propertyNames": { "pattern": "^[^A-Z/]+/[^A-Z/]+$" },
      "additionalProperties": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "warnings": {
      "type": "array",
      "items": { "enum": ["blocked", "private-data", "persistence", "not-in-source", "obfuscated", "no-tls-check", "runs-downloads", "vulnerable"] }
    },
    "plugin": {
      "type": "object",
      "required": ["downloads", "stars", "updated", "root"],
      "additionalProperties": false,
      "properties": {
        "downloads": { "type": "integer", "minimum": 0 },
        "stars": { "type": ["integer", "null"] },
        "updated": { "type": ["string", "null"] },
        "root": { "type": ["boolean", "null"] },
        "fork": { "type": "string" },
        "store": {
          "type": "object",
          "required": ["downloads"],
          "properties": {
            "downloads": { "type": "integer", "minimum": 0 },
            "versions": { "type": "array", "items": { "type": "string" }, "description": "The stable Decky store's versions; only when the listing is surely this repo." },
            "activity": {
              "type": "object",
              "required": ["downloads", "updates"],
              "properties": { "downloads": { "type": "integer", "minimum": 0 }, "updates": { "type": "integer", "minimum": 0 } }
            }
          }
        },
        "ai": { "type": "array", "items": { "type": "string" } },
        "rust": { "const": true, "description": "The repo ships Rust code; written only when true." },
        "warnings": { "$ref": "#/$defs/warnings" },
        "prereleaseWarnings": { "$ref": "#/$defs/warnings" }
      }
    }
  }
}
