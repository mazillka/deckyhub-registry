{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mazillka/deckyhub-registry/main/registry/metadefender.schema.json",
  "title": "MetaDefender reports.json (published on the metadefender-reports branch)",
  "description": "External scan reports keyed by the ZIP's lowercase SHA-256.",
  "type": "object",
  "required": [
    "reports"
  ],
  "properties": {
    "reports": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[0-9a-f]{64}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "enum": [
              "complete",
              "pending",
              "waiting",
              "error",
              "unsupported"
            ]
          },
          "flagged": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "scannedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "dataId": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkedAt": {
            "type": "integer"
          },
          "lastError": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    }
  }
}
